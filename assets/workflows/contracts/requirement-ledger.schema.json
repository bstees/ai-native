{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledgerVersion",
    "readiness",
    "requirements",
    "conflicts"
  ],
  "properties": {
    "ledgerVersion": {
      "const": 1
    },
    "readiness": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-[0-9]{3,}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority",
          "reference"
        ],
        "properties": {
          "authority": {
            "enum": [
              "approved_contract",
              "repository_standard",
              "owner_decision"
            ]
          },
          "reference": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "sources",
        "required",
        "disposition",
        "blockers",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requirementId"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "required": {
          "type": "boolean"
        },
        "disposition": {
          "enum": [
            "pending",
            "blocked",
            "verified",
            "deferred"
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reference"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "test_result",
                  "ci_run",
                  "review_record",
                  "repository_artifact",
                  "agent_claim"
                ]
              },
              "reference": {
                "$ref": "#/$defs/text"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "agent_claim"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "reference": {
                      "$ref": "#/$defs/checkableReference"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirementIds",
        "sources",
        "status",
        "resolutionRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CONFLICT-[0-9]{3,}$"
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        },
        "sources": {
          "$ref": "#/$defs/sources",
          "type": "array",
          "minItems": 2
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolutionRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        }
      }
    },
    "checkableReference": {
      "type": "string",
      "pattern": "^(?:https://[A-Za-z0-9.-]+(?::[0-9]+)?/[^\\s]+|(?:[A-Za-z0-9_][A-Za-z0-9_.-]*/)*[A-Za-z0-9_][A-Za-z0-9_.-]*\\.[A-Za-z0-9][A-Za-z0-9_.-]*(?:#[A-Za-z0-9_.:-]+)?)$"
    }
  }
}
