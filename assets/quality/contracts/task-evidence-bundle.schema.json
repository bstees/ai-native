{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brentstees.com/schemas/ai-native/task-evidence-bundle-v1.json",
  "title": "AI Native Task Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleVersion",
    "bundleId",
    "createdOn",
    "task",
    "implementation",
    "commandEvidence",
    "criterionEvidence",
    "review"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "bundleVersion": { "const": 1 },
    "bundleId": { "type": "string", "pattern": "^EVB-20[0-9]{2}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$" },
    "createdOn": { "$ref": "#/$defs/date" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "revision", "contractPath", "contractFingerprint"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "contractPath": { "type": "string", "minLength": 1 },
        "contractFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "actorType", "branch", "commit", "changedPaths", "changeFingerprint"],
      "properties": {
        "actorId": { "type": "string", "minLength": 1 },
        "actorType": { "enum": ["agent", "human", "hybrid"] },
        "branch": { "type": "string", "minLength": 1 },
        "commit": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-f0-9]{7,64}$" }
          ]
        },
        "changedPaths": { "$ref": "#/$defs/nonEmptyStrings" },
        "changeFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "commandEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode", "result", "evidenceRefs"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer", "minimum": 0 },
          "result": { "enum": ["passed", "failed"] },
          "evidenceRefs": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    },
    "criterionEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "status", "evidenceRefs"],
        "properties": {
          "criterionId": { "type": "string", "pattern": "^AC-[0-9]{3}$" },
          "status": { "enum": ["passed", "failed", "insufficient"] },
          "evidenceRefs": { "$ref": "#/$defs/nonEmptyStrings" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerId",
        "profilePath",
        "independent",
        "readOnly",
        "findings",
        "unresolvedRisks",
        "disposition",
        "reviewedOn"
      ],
      "properties": {
        "reviewerId": { "type": "string", "minLength": 1 },
        "profilePath": { "type": "string", "minLength": 1 },
        "independent": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "status", "summary", "evidenceRefs"],
            "properties": {
              "id": { "type": "string", "pattern": "^REV-[0-9]{3}$" },
              "severity": { "enum": ["blocking", "major", "minor", "note"] },
              "status": { "enum": ["open", "resolved", "accepted_risk"] },
              "summary": { "type": "string", "minLength": 1 },
              "evidenceRefs": { "$ref": "#/$defs/nonEmptyStrings" }
            }
          }
        },
        "unresolvedRisks": { "$ref": "#/$defs/strings" },
        "disposition": { "enum": ["verified", "changes_required", "blocked"] },
        "reviewedOn": { "$ref": "#/$defs/date" }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
