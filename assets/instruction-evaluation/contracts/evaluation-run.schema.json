{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-native.local/instruction-evaluation/evaluation-run.schema.json",
  "title": "Instruction evaluation run",
  "type": "object",
  "additionalProperties": false,
  "required": ["variant", "model", "instructionFiles", "results"],
  "properties": {
    "variant": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "modelSettings": { "type": "object" },
    "instructionFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "attempts"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "attempts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["success", "inputTokens", "outputTokens", "qualityScores", "violations"],
              "properties": {
                "success": { "type": "boolean" },
                "inputTokens": { "type": "integer", "minimum": 0 },
                "outputTokens": { "type": "integer", "minimum": 0 },
                "toolCalls": { "type": "integer", "minimum": 0, "default": 0 },
                "retries": { "type": "integer", "minimum": 0, "default": 0 },
                "humanCorrections": { "type": "integer", "minimum": 0, "default": 0 },
                "qualityScores": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "number", "minimum": 0 }
                },
                "violations": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
